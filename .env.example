# Copy to .env (never commit it). Everything here is read server-side only.

# --- Project ---
GITHUB_URL=git@github.com:zeffirojoe/angel-portfolio.git
SITE_URL=https://example.com                # public site URL, used for metadata

# --- Instagram ---
INSTAGRAM_ACCOUNT=https://www.instagram.com/tattooist_angel/
INSTAGRAM_USERNAME=tattooist_angel
# From the app dashboard: Instagram > API setup > Generate access tokens > Generate token.
INSTAGRAM_ACCESS_TOKEN=
# The number under the account name on that same page. Required for Unified Login
# tokens, which can't list their own accounts.
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v26.0

# --- Booking inquiry delivery ---
EMAIL=artist@example.com                    # where inquiries are delivered
# Any SMTP service. Gmail: smtp.gmail.com / 465 / the address / a 16-character App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                                  # optional, defaults to SMTP_USER
